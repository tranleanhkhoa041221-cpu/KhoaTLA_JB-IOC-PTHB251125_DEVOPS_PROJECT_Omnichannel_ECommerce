# Preset STANDARD: >= 4 vCPU / 8 GB RAM (dung dung cau hinh de bai de xuat). Noi vao .env.
MEM_POSTGRES=768m
PG_SHARED_BUFFERS=256MB
PG_EFFECTIVE_CACHE=1GB
PG_MAX_CONNECTIONS=200
MEM_REDIS=192m
REDIS_MAXMEMORY=128mb
MEM_KAFKA=1g
KAFKA_HEAP=-Xms512m -Xmx768m
MEM_SVC=512m
MEM_ORDER=768m
JAVA_OPTS_SVC=-XX:MaxRAMPercentage=70 -XX:+UseG1GC -XX:+ExitOnOutOfMemoryError
JAVA_OPTS_ORDER=-XX:MaxRAMPercentage=70 -XX:+UseG1GC -XX:+ExitOnOutOfMemoryError
HIKARI_SVC=10
HIKARI_ORDER=30
TOMCAT_SVC=200
TOMCAT_ORDER=400
