# =============================================================================
# Preset 4GB: VPS 4 GB RAM (>= 2 vCPU khuyen nghi) — core + FULL monitoring + OTel agent.
# Noi vao /opt/quickbite/.env :   cat profiles/4gb.env >> .env      (key trung: dong CUOI thang)
# KHONG dung profiles/standard.env cho 4GB (preset do danh cho 8GB, tong mem_limit ~5.3GB).
# v21: MaxMetaspaceSize 96m->160m (Spring Boot 4 + gRPC + JPA + Security bi OOM Metaspace luc khoi dong), mem_limit tang tuong ung.
# So lieu la UOC TINH tu mem_limit, phai xac nhan bang `docker stats` thuc te.
#   OS+Docker+Nginx ~300 | pg 256 + redis 64 + kafka 384 | 6 service x 400 (khi bat tracing) = 2400
#   monitoring: prometheus 128 + grafana 128 + loki 200 + promtail 80 + jaeger 256 = 792   => ~4.2 GB TRAN (mem_limit la tran, RSS thuc te thap hon; swap 3GB do phan con lai). Bat tung buoc: core -> monitoring -> tracing.
# =============================================================================
MEM_POSTGRES=256m
PG_SHARED_BUFFERS=64MB
PG_EFFECTIVE_CACHE=256MB
PG_MAX_CONNECTIONS=100
MEM_REDIS=96m
REDIS_MAXMEMORY=64mb
MEM_KAFKA=384m
KAFKA_HEAP=-Xms192m -Xmx256m
MEM_SVC=340m
MEM_ORDER=380m
MEM_SVC_TRACING=400m
JAVA_OPTS_SVC=-Xms64m -Xmx128m -XX:MaxMetaspaceSize=144m -XX:+UseSerialGC -Xss512k -XX:TieredStopAtLevel=1 -XX:+ExitOnOutOfMemoryError -XX:ReservedCodeCacheSize=48m -XX:MaxDirectMemorySize=48m -Dspring.jmx.enabled=false
JAVA_OPTS_ORDER=-Xms96m -Xmx192m -XX:MaxMetaspaceSize=144m -XX:+UseSerialGC -Xss512k -XX:TieredStopAtLevel=1 -XX:+ExitOnOutOfMemoryError -XX:ReservedCodeCacheSize=48m -XX:MaxDirectMemorySize=48m -Dspring.jmx.enabled=false
HIKARI_SVC=8
HIKARI_ORDER=16
TOMCAT_SVC=60
TOMCAT_ORDER=120