# =============================================================================
# /opt/quickbite/.env  (cp .env.production.example .env && chmod 600 .env) — KHONG commit
# Sinh secret: openssl rand -base64 36 | tr -d '/+='
# CI/CD tu ghi IMAGE_PREFIX + IMAGE_TAG; ban chi dien cac gia tri con trong.
# =============================================================================
DOMAIN=khoatla-ecommerce.duckdns.org
IMAGE_PREFIX=ghcr.io/YOUR_GITHUB_USERNAME_LOWERCASE
IMAGE_TAG=latest

# ---- Postgres: superuser (init/backup) + role rieng cho moi service ----
DB_SUPERUSER=postgres
DB_SUPERUSER_PASSWORD=
DB_PASS_IDENTITY_USER=
DB_PASS_PRODUCT_CATALOG=
DB_PASS_ORDER_INVENTORY=
DB_PASS_PAYMENT_BILLING=
DB_PASS_NOTIFICATION=

# ---- Bao mat ----
JWT_SECRET_KEY=
INTERNAL_API_KEY=
ADMIN_DEFAULT_PASSWORD=
CORS_ALLOWED_ORIGINS=https://khoatla-ecommerce.duckdns.org,http://localhost:8082,http://localhost:8083,http://localhost:8084,http://localhost:8085,http://localhost:8086
# URL API Gateway public — Swagger UI dung lam base URL (giong Postman baseUrl).
# Postman: {{baseUrl}} = https://khoatla-ecommerce.duckdns.org | Swagger: server dropdown = gia tri nay.
GATEWAY_BASE_URL=https://khoatla-ecommerce.duckdns.org

# ---- Monitoring (chi can khi bat monitoring/docker-compose.monitoring.yml) ----
GRAFANA_PASSWORD=

# ---- VNPay / Mail / SMS: CHI dien khi that su test chuc nang do (mac dinh tat/trong) ----
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_RETURN_URL=https://khoatla-ecommerce.duckdns.org/api/payments/vnpay/return
# De trong = IP mac dinh cua VNPay. Test mo phong IPN tu may ca nhan: dat * tam thoi roi XOA sau khi test.
VNPAY_IPN_ALLOWED_IPS=
VNPAY_IPN_URL=https://khoatla-ecommerce.duckdns.org/api/payments/vnpay/ipn
NOTIFICATION_MAIL_ENABLED=false
MAIL_USERNAME=
MAIL_PASSWORD=
NOTIFICATION_SMS_ENABLED=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

LOG_LEVEL=INFO
# true = Redis Distributed Lock (dung de bai) + atomic UPDATE o DB. Doi false chi khi load test 500+ RPS tren VPS yeu.
USE_REDIS_LOCK=true

# ---- Compose: nap file nao (deploy.yml + scripts goi `docker compose` TRAN, khong co -f) ----
# VPS 1-2GB (chi core):
COMPOSE_FILE=docker-compose.production.yml
# VPS 4GB FULL monitoring + tracing: BO dong tren, dung 2 dong duoi (them: cat profiles/4gb.env >> .env)
# COMPOSE_FILE=docker-compose.production.yml:monitoring/docker-compose.monitoring.yml:monitoring/docker-compose.tracing.yml
# COMPOSE_PROFILES=full
